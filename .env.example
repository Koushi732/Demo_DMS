# Aureon Quality Document Control System — Environment Configuration

# ============================================================
# SUPABASE
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# BACKEND API
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ============================================================
# FASTAPI BACKEND
# ============================================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/aureon_dms
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ============================================================
# STORAGE
# ============================================================
STORAGE_BUCKET=documents
STORAGE_URL=https://your-project.supabase.co/storage/v1

# ============================================================
# REDIS (for ARQ background workers)
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# AI PROVIDER
# ============================================================
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================================
# OCR
# ============================================================
OCR_PROVIDER=tesseract
TESSERACT_CMD=/usr/bin/tesseract

# ============================================================
# APPLICATION
# ============================================================
APP_NAME=Aureon Quality Document Control System
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:3000
SECRET_KEY=your-secret-key-for-signing

# ============================================================
# FILE UPLOAD LIMITS
# ============================================================
MAX_FILE_SIZE_MB=100
ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.jpg,.jpeg,.png,.tiff
